# Anthropic API Key (required for code generation)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Vedaa API (Railway backend URL in production)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Netlify (One-Click Publish)
# Get your token at: https://app.netlify.com/user/applications#personal-access-tokens
NF_TOKEN=your-netlify-personal-access-token
NF_SITE_PREFIX=devos
# Base domain for published apps (e.g. vedaa.io → slug.vedaa.io)
# Requires *.vedaa.io wildcard CNAME pointing to Netlify
NF_CUSTOM_DOMAIN=vedaa.io
