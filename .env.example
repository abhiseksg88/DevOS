# =============================================================================
# Vedaa Environment Variables (Backend — Railway)
# Copy to .env and fill in your values
# =============================================================================

# --- Supabase ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- LLM Providers ---
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...

# --- Docker / Deploy ---
CONTAINER_REGISTRY=gcr.io/your-project
DEPLOY_PROVIDER=cloudrun
GCP_PROJECT=your-gcp-project
GCP_REGION=us-central1
FLY_ORG=your-fly-org

# --- Preview ---
PREVIEW_DOMAIN=preview.vedaa.io
PREVIEW_STALE_HOURS=72
PREVIEW_DELETE_DAYS=7

# --- Caddy (for preview routing) ---
CLOUDFLARE_API_TOKEN=your-cf-token

# --- Rate Limiting ---
RATE_LIMIT_FREE=10
RATE_LIMIT_PRO=100
RATE_LIMIT_ENTERPRISE=500

# --- Netlify (One-Click Publish) ---
# Get your token at: https://app.netlify.com/user/applications#personal-access-tokens
NETLIFY_TOKEN=your-netlify-personal-access-token
NETLIFY_TEAM_SLUG=vedaa
NETLIFY_SITE_PREFIX=vedaa
NETLIFY_CUSTOM_DOMAIN=vedaa.io

# --- CORS / Frontend ---
# Set FRONTEND_URL to your Netlify app URL so the backend allows requests from it.
# This is auto-added to CORS allowed origins on startup.
FRONTEND_URL=https://your-app.netlify.app
# Or set CORS_ALLOWED_ORIGINS as comma-separated list for full control:
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://vedaa.io,https://your-app.netlify.app
